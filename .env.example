# Use development locally. Production startup requires the exact value production.
FLASK_CONFIG=development
# Required in production. Generate and store a strong, unique value outside Git.
SECRET_KEY=
# Required in production. Use the SQLAlchemy URL for the protected SQLite file.
DATABASE_URL=
# Required in production. Use a Fernet key generated outside the repository.
MFA_ENCRYPTION_KEY=
# Required in production: redis:// or rediss://. Keep credentials outside Git.
RATELIMIT_STORAGE_URI=
# Development and testing use memory:// and do not require this variable.
# Optional in production: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Default: INFO.
LOG_LEVEL=INFO
